# Copy to .env (never commit .env)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
VISION_TIMEOUT_MS=20000
SLACK_WEBHOOK_URL=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
DB_PATH=./data/invoice-guard.db

# Slack bot (T18). On the GB10 keep these in ~/.invoice-guard-slack.env (chmod 600), not in .env.
# Bot token only (xoxb-); user tokens (xoxp-) are refused. Scopes: chat:write. Socket Mode on, Interactivity on.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Slack user ID -> Invoice Guard user, e.g. {"U012ABC":"janet.kim","U045DEF":"omar.reyes"}
SLACK_USERS=
# Invoice Guard users -> roles (default: janet.kim ap_clerk, omar.reyes + pat.lee ap_manager)
IG_USERS=
# Optional: other location for the Slack env file
SLACK_ENV_FILE=
